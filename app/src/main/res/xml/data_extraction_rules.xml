<?xml version="1.0" encoding="utf-8"?>
<!--
  Tunes: nothing leaves the device through cloud backup or device transfer.
  Sign-in cookies, account tokens and scrobbler keys live in app storage, and
  restoring them onto another device would hand a live session to whoever
  restores the backup. Library and settings move through Settings → Export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
